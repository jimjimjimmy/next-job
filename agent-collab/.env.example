# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google Docs API
# ID of the doc, taken from its URL: https://docs.google.com/document/d/<GOOGLE_DOC_ID>/edit
GOOGLE_DOC_ID=
# Path to a service account JSON key with access to the doc (share the doc with the
# service account's client_email). See README.md for setup steps.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Polling interval while monitoring, in milliseconds
POLL_INTERVAL_MS=15000

# Set to "true" to use the local mock doc (tests/mock-doc.json) instead of the
# real Google Docs API — no credentials needed. Also auto-enabled when
# GOOGLE_DOC_ID or GOOGLE_APPLICATION_CREDENTIALS is missing.
USE_MOCK_DOC=false
